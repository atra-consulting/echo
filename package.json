{
  "name": "zeugnisgenerator",
  "description": "Arbeitszeugnisse (Abschluss- und Zwischenzeugnis) aus Textbausteinen zusammenstellen",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "serve -s dist/zeugnisgenerator/browser -p 8080",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:server": "tsc -p server/tsconfig.json && node server/build.mjs",
    "test:server": "tsc -p server/tsconfig.json && node server/build.mjs --test && node --test --enable-source-maps \"dist/server-test/**/*.spec.cjs\"",
    "start:server": "node --enable-source-maps dist/server/main.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@google-cloud/firestore": "^9.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "rxjs": "~7.8.0",
    "serve": "^14.2.5",
    "tslib": "^2.8.1",
    "zod": "^4.6.7",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.2",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.9.3"
  }
}
