# This .gitignore file is designed to function as a whitelist.
# Add a matching pattern to the list for keeping track of your files.
# The two lines below changes the .gitignore file from a blacklist to a whitelist, do not touch them.
*
!*/

# Documentation
!/CHANGELOG.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/docs/**

# Contribution
!/.editorconfig
!/.gitignore

# Build
!/.github/**
!/.dockerignore
!/.releaserc.yml
!/angular.json
!/commitlint.config.js
!/compose.yaml
!/deploy/**
!/Dockerfile
!/package.json
!/package-lock.json
!/proxy.conf.json
!/tsconfig.app.json
!/tsconfig.json
!/tsconfig.spec.json

# Source
!/**/src/**
!/server/**
!/scripts/**

# Blacklist
node_modules
